within AnomalyLibrary;
package Examples "Self-contained examples of anomaly components"
  extends Modelica.Icons.ExamplesPackage;
  annotation(Documentation(info="<html><p>Nine examples demonstrate signal, command, communication and physical effects using Modelica Standard Library components. Each example includes its sources and boundary conditions and provides stored experiment settings.</p><p>Begin with <a href=\"modelica://AnomalyLibrary.Examples.SignalDeviationAndRecovery\">SignalDeviationAndRecovery</a>, then choose the example for the required physical or communication interface. The example documentation states the principal quantities to inspect.</p></html>"));
end Examples;
