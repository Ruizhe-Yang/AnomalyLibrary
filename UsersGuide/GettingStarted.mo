within AnomalyLibrary.UsersGuide;
class GettingStarted "Load the library and run a first example"
  extends Modelica.Icons.Information;
  annotation(Documentation(info="<html><p>Load Modelica Standard Library 4.0.0, then open <code>AnomalyLibrary/package.mo</code>. Run <a href=\"modelica://AnomalyLibrary.Examples.SignalDeviationAndRecovery\">Examples.SignalDeviationAndRecovery</a> with its stored experiment settings. Compare <code>biasValue</code>, <code>freezeValue</code> and <code>gainValue</code> with the ramp input.</p><p>For a new signal model, place a component between the source and its consumer. Enable it, configure the internal interval or external trigger, and choose the effect parameters. Physical components must be connected in the series, parallel or boundary arrangement described by their class documentation. Start with the corresponding example.</p><p>The complete English manual is <code>docs/UserGuide.md</code>; the Chinese edition is <code>docs/UserGuide.zh-CN.md</code>.</p></html>"));
end GettingStarted;
