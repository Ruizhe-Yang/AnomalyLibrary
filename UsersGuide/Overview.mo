within AnomalyLibrary.UsersGuide;
class Overview "Library scope and package organisation"
  extends Modelica.Icons.Information;
  annotation(Documentation(info="<html><p>AnomalyLibrary provides deterministic deviations in signals, communication frames and physical connections. Components are configured explicitly through activation settings, effect parameters and Modelica connectors.</p><p><code>Signals</code> modifies Real or Boolean signals; <code>Communication</code> processes frame payloads and metadata. <code>Electrical</code>, <code>Mechanics</code>, <code>Thermal</code> and <code>Fluid</code> introduce effects through their physical interfaces. <code>CrossDomain</code> connects selected effects across domains. <code>Examples</code> contains nine self-contained demonstrations.</p></html>"));
end Overview;
